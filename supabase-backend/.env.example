# Copia este fichero a `.env` y rellénalo con los valores de tu proyecto.
# `.env` está en .gitignore y no se sube nunca.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://TU-REF.supabase.co

# Project Settings -> API -> Publishable key (antes se llamaba "anon").
SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_PUBLICABLE

# Project Settings -> Database -> Connection string (URI), pestaña SESSION POOLER.
# No uses la pestaña "Direct connection": `db.<ref>.supabase.co` solo resuelve a
# IPv6 y no es alcanzable desde una red sin IPv6.
SUPABASE_DB_URL=postgresql://postgres.TU-REF:TU_CONTRASENA@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# Email y contraseña con los que se registran los tests.
SUPABASE_TEST_EMAIL=pruebas@ejemplo.dev
SUPABASE_TEST_PASSWORD=TU_CONTRASENA_DE_PRUEBAS